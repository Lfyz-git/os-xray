<?xml version="1.0"?>
<model>
    <mount>//OPNsense/xray/subscriptions</mount>
    <description>Xray Subscription Sources</description>
    <version>1.0.0</version>
    <items>
        <subscription type="ArrayField">
            <enabled type="BooleanField">
                <Default>1</Default>
            </enabled>
            <name type="TextField">
                <Required>Y</Required>
            </name>
            <source_type type="OptionField">
                <Default>url</Default>
                <OptionValues>
                    <url>Subscription URL</url>
                    <links>Pasted VLESS Links</links>
                </OptionValues>
            </source_type>
            <url type="TextField">
                <Required>N</Required>
            </url>
            <links type="TextField">
                <Required>N</Required>
            </links>
            <outbounds type="TextField">
                <Required>N</Required>
            </outbounds>
            <node_count type="IntegerField">
                <Default>0</Default>
                <MinimumValue>0</MinimumValue>
                <MaximumValue>256</MaximumValue>
            </node_count>
            <updated_at type="TextField">
                <Required>N</Required>
            </updated_at>
        </subscription>
    </items>
</model>
